[color]
	ui = auto
	diff = always
	status = always
	branch = always
	interactive = always
[core]
	excludesfile = $HOME/.gitignore
	editor = nvim
	ignorecase = false
	fileMode = true
	trustctime = false
[difftool "Kaleidoscope"]
        cmd = ksdiff-wrapper git \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = Kaleidoscope
	mnemonicprefix = true
	renames = copies
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	co = checkout
	c = commit
	wt = worktree
	up = pull --rebase --autostash
	mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
	fix = !${EDITOR} -- $(git diff --name-only --relative --diff-filter=U | uniq)
	rmbwt = "!f() { \
			local force=0; \
			local branch=\"\"; \
			while [ $# -gt 0 ]; do \
					case \"$1\" in \
							-f|--force) force=1; shift ;; \
							*) branch=\"$1\"; shift ;; \
					esac; \
			done; \
			if [ -z \"$branch\" ]; then \
					echo \"Error: Please provide a branch name.\" >&2; \
					echo \"Usage: git rmbranch [-f|--force] <branch-name>\" >&2; \
					return 1; \
			fi; \
			local wt_path; \
			wt_path=$(git worktree list --porcelain | awk -v b=\"refs/heads/$branch\" '/^worktree / { wt=substr($0, 10) } /^branch / { if ($2 == b) print wt }'); \
			if [ -n \"$wt_path\" ]; then \
					echo \"--> Found worktree at: $wt_path\"; \
					if [ \"$force\" -eq 1 ]; then \
							echo \"--> Force removing worktree...\"; \
							git worktree remove --force \"$wt_path\" || return 1; \
					else \
							echo \"--> Removing worktree...\"; \
							git worktree remove \"$wt_path\" || return 1; \
					fi; \
			else \
					echo \"--> No active worktree found for branch '$branch'.\"; \
			fi; \
			if [ \"$force\" -eq 1 ]; then \
					echo \"--> Force deleting branch '$branch'...\"; \
					git branch -D \"$branch\"; \
			else \
					echo \"--> Deleting branch '$branch'...\"; \
					git branch -d \"$branch\"; \
			fi; \
	}; f"
[mergetool]
	keepBackup = true
[branch]
	autosetuprebase = always
[push]
	default = current
[credential]
	helper = osxkeychain
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[merge]
	commit = no
	ff = no
[rerere]
	enabled = true
;[gpg]
	;format = ssh
;[gpg "ssh"]
	;program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
;[commit]
	;gpgsign = true

[diff "dyff"]
	command = dyff_between() { dyff --color on between --omit-header \"$2\" \"$5\"; }; dyff_between
[commit]
	gpgsign = false
[init]
	defaultBranch = dev
[tag]
	gpgsign = false
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[beads]
	role = maintainer
